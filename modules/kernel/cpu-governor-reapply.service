[Unit]
Description=Re-apply CPU governor pin after PPD profile change (kickstart)
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
After=power-profiles-daemon.service
Wants=power-profiles-daemon.service

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/bin/kickstart-cpu-governor.sh
StandardOutput=journal
StandardError=journal
