[Unit]
Description=CPU governor pin + pre-boost freq cap (kickstart)
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
After=multi-user.target power-profiles-daemon.service
Wants=power-profiles-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/kickstart-cpu-governor.sh
ExecStop=/usr/bin/kickstart-cpu-governor.sh revert
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
